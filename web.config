<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>

    <handlers>
      <add name="iisnode"
           path="server.js"
           verb="*"
           modules="iisnode"
           resourceType="Unspecified" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="C:\Program Files (x86)\nodejs\22.23.2\node.exe"
      loggingEnabled="true"
      devErrorsEnabled="true"
      nodeProcessCountPerApplication="1"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250" />

  </system.webServer>

</configuration>