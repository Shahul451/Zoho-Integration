<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Serve static HTML site directly — no iisnode needed -->
    <staticContent>
      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico"   mimeType="image/x-icon" />
    </staticContent>

    <!-- Default page is index.html -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Serve real files as-is (CSS, JS, images, etc.) -->
        <rule name="StaticFiles" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Serve real directories as-is -->
        <rule name="StaticDirs" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Everything else → index.html (SPA fallback) -->
        <rule name="SPA_Fallback" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="customer_portal/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security: hide source folders from public access -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="src" />
          <add segment="config" />
          <add segment="sample_data" />
          <add segment="fabric_artifacts" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
