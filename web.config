<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Serve static HTML site directly — no iisnode needed -->
    <staticContent>
      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico"   mimeType="image/x-icon" />
    </staticContent>

    <!-- Point default document to actual portal page -->
    <defaultDocument>
      <files>
        <clear />
        <add value="customer_portal/index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Serve real static files as-is (CSS, JS, images, fonts, etc.) -->
        <rule name="StaticFiles" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Root request → serve the portal index.html -->
        <rule name="RootToPortal" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="customer_portal/index.html" />
        </rule>

        <!-- All other requests (directories, unknown paths) → portal index.html -->
        <rule name="SPA_Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="customer_portal/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Disable directory browsing to prevent 403 on folder requests -->
    <directoryBrowse enabled="false" />

    <!-- Security: hide backend source folders from public access -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="src" />
          <add segment="config" />
          <add segment="sample_data" />
          <add segment="fabric_artifacts" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
