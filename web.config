<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
 
    <webSocket enabled="false" />
 
    <!-- Tell IIS: route ALL requests through iisnode using server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
 
    <rewrite>
      <rules>
        <!-- Rule 1: Skip rewriting node_modules folder (leave as-is) -->
        <rule name="NodeModules" stopProcessing="true">
          <match url="node_modules/.*" />
          <action type="None" />
        </rule>
        <!-- Rule 2: Skip rewriting public static files -->
        <rule name="StaticPublic" stopProcessing="true">
          <match url="public/.*" />
          <action type="None" />
        </rule>
        <!-- Rule 3: Send all other requests to Node.js app -->
        <rule name="DynamicContent">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
 
    <!-- iisnode settings -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      watchedFiles="*.js;web.config"
      gracefulShutdownTimeout="60000"
      maxLogFileSizeInKB="128"
      maxTotalLogFileSizeInKB="1024"
      maxLogFiles="20" />
 
    <!-- Block public access to sensitive folders -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="iisnode" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
 
  </system.webServer>
</configuration>
 